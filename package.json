{
  "name": "endchess-models",
  "version": "2.2.16",
  "description": "Mongoose schemas and server-side domain helpers for EndChess",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "tsc": "tsc",
    "build": "npm run clean && tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "jest --config jest.config.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reblackwell3/endchess-models.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/reblackwell3/endchess-models/issues"
  },
  "homepage": "https://github.com/reblackwell3/endchess-models#readme",
  "dependencies": {
    "chess.js": "^1.4.0",
    "endchess-contracts": "2.0.4",
    "pgn-parser": "^2.2.1",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "endchess-npm-publish-ci": "^1.0.0",
    "@types/jest": "^29.5.13",
    "@types/mongoose": "^5.11.97",
    "mongoose": "^8.6.1",
    "@types/typescript": "^2.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.1",
    "ts-jest": "^29.2.5"
  }
}
